# ===========================================
# 윌리엄 오닐 돌파매매 봇 환경 설정
# ===========================================
# 이 파일을 .env로 복사한 후 값을 설정하세요
# cp .env.example .env

# -------------------------------------------
# 텔레그램 설정 (필수)
# -------------------------------------------
# 텔레그램 봇 토큰 (@BotFather에서 발급)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 텔레그램 채팅 ID (봇에게 메시지 보낸 후 getUpdates API로 확인)
TELEGRAM_CHAT_ID=your_chat_id_here

# -------------------------------------------
# 스캔 설정
# -------------------------------------------
# 스캔 주기 (초, 기본값: 1800 = 30분)
SCAN_INTERVAL=1800

# 분석 기간 (기본값: 6mo)
# 옵션: 1mo, 3mo, 6mo, 1y, 2y
ANALYSIS_PERIOD=6mo

# -------------------------------------------
# 거래 설정
# -------------------------------------------
# 손절 비율 (%, 음수, 기본값: -8)
STOP_LOSS_PCT=-8.0

# 익절 비율 (%, 기본값: 20)
TAKE_PROFIT_PCT=20.0

# 최대 보유 기간 (일, 기본값: 30)
MAX_HOLDING_DAYS=30

# -------------------------------------------
# 패턴 감지 설정
# -------------------------------------------
# 거래량 급증 최소 비율 (%, 기본값: 50)
VOLUME_SURGE_MIN=50.0

# 돌파 최대 비율 (%, 기본값: 5)
BREAKOUT_MAX=5.0