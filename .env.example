# 윌리엄 오닐 돌파매매 봇 설정 예제
# 이 파일을 .env로 복사하고 실제 값으로 변경하세요

# ========================================
# 텔레그램 설정 (필수)
# ========================================
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ========================================
# SSH 터널 설정 (PostgreSQL 연결용)
# ========================================
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USER=your_ssh_user
SSH_KEY_PATH=~/.ssh/your_key

# ========================================
# PostgreSQL 설정
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=us_oneil_simple_notifier_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ========================================
# 스캔 설정
# ========================================
SCAN_INTERVAL=1800
REQUEST_DELAY=1.0

# ========================================
# 거래 설정
# ========================================
STOP_LOSS_PCT=-8.0
TAKE_PROFIT_PCT=20.0
MAX_HOLDING_DAYS=30
MAX_POSITIONS=5
POSITION_SIZE_PCT=20.0

# ========================================
# 패턴 감지 설정 - 피벗 돌파
# ========================================
VOLUME_SURGE_MIN=50.0
BREAKOUT_MAX=5.0

# ========================================
# 패턴 감지 설정 - 컵앤핸들
# ========================================
CUP_DEPTH_MIN=12.0
CUP_DEPTH_MAX=40.0
HANDLE_DEPTH_MAX=12.0

# ========================================
# 패턴 감지 설정 - 베이스 돌파
# ========================================
BASE_VOLATILITY_MAX=15.0
BASE_VOLUME_SURGE_MIN=40.0
BASE_BREAKOUT_MAX=7.0

# ========================================
# 데이터 설정
# ========================================
ANALYSIS_PERIOD=6mo

# ========================================
# 워치리스트 (콤마로 구분)
# ========================================
US_STOCKS=AAPL,MSFT,GOOGL,AMZN,META,NVDA,AMD,AVGO,TSLA,NFLX,CRM,ADBE,PLTR,SNOW,CRWD,NET,DDOG,ZS,COIN,SQ,PYPL,SHOP

# ========================================
# 파일 경로 설정
# ========================================
WATCHLIST_FILE=watchlist.json
POSITIONS_FILE=positions.json